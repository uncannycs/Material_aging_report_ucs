<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="material_ageing_report_view" model="ir.ui.view">
            <field name="name">Material Ageing Report</field>
            <field name="model">material.ageing.report</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <separator string="Material Ageing Report" invisible="1"/>
                            <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <separator string="Material Ageing Report" invisible="1"/>
                        </group>
                    </group>
                    <field name="name" invisible="1"/>
                    <h1>
                        <field name="output" filename="name"/>
                        <field name="company_id" invisible="1"/>
                    </h1>
                    <footer>
                        <button name="action_report" string="Get Report" class="oe_highlight" type="object"/>
                        or
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="action_material_ageing_report_view" model="ir.actions.act_window">
            <field name="name">Material Ageing Report</field>
            <field name="res_model">material.ageing.report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="material_ageing_report_view"/>
            <field name="context">{}</field>
            <field name="target">new</field>
        </record>

        <menuitem id="material_ageing_report_menu"
            parent="stock.menu_warehouse_report"
            action="action_material_ageing_report_view"
            name="Material Ageing Report"
            sequence="8"
            />

    </data>
</odoo>
